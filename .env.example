# 接続先の Postgres。Supabase なら Project Settings → Database → Connection string。
# Vercel から使う場合は Session pooler (5432) か Transaction pooler (6543) を選ぶ。
DATABASE_URL=postgresql://user:password@host:5432/postgres

# 抽選プールに占める偉人の言葉の比率(残りがユーザーの言葉)。企画上の初期値は 0.7。
CLASSIC_RATIO=0.7

# 1日1回の制限を外す。開発中とデモ中だけ true にする。本番は未設定のままにする。
ALLOW_REROLL=false

# 「1日」の区切りを判定するタイムゾーン。
TIMEZONE=Asia/Tokyo
